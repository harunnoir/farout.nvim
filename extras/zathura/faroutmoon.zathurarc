# FarOut color theme for Zathura
# Swaps Foreground for Background to get a light version if the user prefers
#
# FarOut color theme
#
set notification-error-bg "#cf573c"
set notification-error-fg "#E8D5B7"
set notification-warning-bg "#f2b776"
set notification-warning-fg "#3d2e2a"
set notification-bg "#0f0908"
set notification-fg "#E8D5B7"
set completion-bg "#0f0908"
set completion-fg "#D4A574"
set completion-group-bg "#0f0908"
set completion-group-fg "#D4A574"
set completion-highlight-bg "#3d2e2a"
set completion-highlight-fg "#E8D5B7"
set index-bg "#0f0908"
set index-fg "#E8D5B7"
set index-active-bg "#3d2e2a"
set index-active-fg "#E8D5B7"
set inputbar-bg "#0f0908"
set inputbar-fg "#E8D5B7"
set statusbar-bg "#0f0908"
set statusbar-fg "#E8D5B7"
set highlight-color "#f2b776"
set highlight-active-color "#b4997f"
set default-bg "#0f0908"
set default-fg "#E8D5B7"
set render-loading true
set render-loading-fg "#0f0908"
set render-loading-bg "#E8D5B7"
#
# Recolor mode settings
# <C-r> to switch modes
#
set recolor-lightcolor "#0f0908"
set recolor-darkcolor "#E8D5B7"
