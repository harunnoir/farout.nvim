# FarOut colors for dunst
# For more configuraion options see https://github.com/dunst-project/dunst/blob/master/dunstrc

[urgency_low]
    background = "#1a1311"
    foreground = "#E8D5B7"
    frame_color = "#E8D5B7"

[urgency_normal]
    background = "#0f0908"
    foreground = "#E8D5B7"
    frame_color = "#E8D5B7"

[urgency_critical]
    background = "#2a1e1a"
    foreground = "#ef775c"
    frame_color = "#ef775c"
