[delta]
  minus-style                   = syntax "#311915"
  minus-non-emph-style          = syntax "#311915"
  minus-emph-style              = syntax "#743b2e"
  minus-empty-line-marker-style = syntax "#311915"
  line-numbers-minus-style      = "#8f3d2b"
  plus-style                    = syntax "#2e2520"
